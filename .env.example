# PMOVES-Jellyfin - PMOVES Branded Defaults
# Source: pmoves/env.shared in parent PMOVES.AI repo
# Dual-mode: standalone (fork) or docked (PMOVES.AI integration)

# =============================================================================
# IMAGE CONFIGURATION
# =============================================================================
# Docker image to use
JELLYFIN_IMAGE=ghcr.io/powerfulmoves/pmoves-jellyfin:pmoves-latest

# Upstream Jellyfin base image (for building)
JELLYFIN_UPSTREAM=ghcr.io/jellyfin/jellyfin:latest

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# Container name
CONTAINER_NAME=pmoves-jellyfin

# Network name for standalone mode
NETWORK_NAME=pmoves_app

# Parent data network (when docked to PMOVES.AI)
PARENT_DATA_NETWORK=pmoves_data

# Volume prefix for named volumes
VOLUME_PREFIX=jellyfin

# =============================================================================
# PORTS & URLS
# =============================================================================
# Web UI port
# - Standalone/Docked: 8096 (no conflicts in hardened architecture)
JELLYFIN_PORT=8096

# Published URL (for external access behind reverse proxy)
JELLYFIN_PUBLISHED_URL=http://localhost:8096

# =============================================================================
# MEDIA STORAGE
# =============================================================================
# Path to media files (mounts to /media in container)
MEDIA_PATH=./media

# =============================================================================
# TIMEZONE
# =============================================================================
TZ=UTC

# =============================================================================
# PMOVES INTEGRATION
# =============================================================================
# Mode: standalone or docked
# - standalone: Runs independently with local configuration
# - docked: Connects to PMOVES.AI infrastructure (requires parent network)
PMOVES_MODE=standalone

# =============================================================================
# PMOVES BRANDED DEFAULTS - Application Credentials
# =============================================================================
# Default admin credentials
# PMOVES standard: pmoves@pmoves.ai for ALL services
# IMPORTANT: Change these after first login!
JELLYFIN_ADMIN_USERNAME=pmoves@pmoves.ai
JELLYFIN_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# NOTES
# =============================================================================
# - First run will create admin user at http://localhost:8096
# - Media directory should contain subdirectories: movies, tvshows, music, etc.
# - When docked to PMOVES.AI, set PMOVES_MODE=docked
# - For docked mode, ensure pmoves_data network exists in parent
